# An agentmux instance config that uses this setup. Copy it to
# ~/.config/agentmux/instances/<name>, adjust, then `agentmux start`.
# `agentmux check` reads it and says what is wrong.

setup = ~/code/agentwork

prefix = ctrl+b

left.command = tray
left.description = The agent list
left.needs-agents = true
left.visible = true
left.width = 26

drawer.command = agentmux screen --text drawer
drawer.visible = false
drawer.height = 8

dock.command = agentmux screen --text dock
dock.visible = false
dock.width = 40

right.command = agentmux screen --text right
right.visible = false
right.width = 40
