# An agentmux instance config that uses this setup. Copy it to
# ~/.config/agentmux/instances/<name>, adjust, then `agentmux start`.
# `agentmux check` reads it and says what is wrong.

setup = ~/code/agentwork

prefix = ctrl+b

tray.command = tray
tray.description = The agent list
tray.visible = true
tray.width = 26

drawer.command = agentmux screen --text drawer
drawer.visible = false
drawer.height = 8

canvas.command = agentmux screen --text canvas
canvas.visible = false
canvas.width = 40

rail.command = agentmux screen --text rail
rail.visible = false
rail.width = 40
